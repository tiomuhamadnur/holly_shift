# Development environment. Copy to .env and adjust. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-real-environments
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
LANGUAGE_CODE=id
SESSION_COOKIE_AGE=43200

# Leave empty to use local SQLite for development.
# POSTGRES_DB=holly_shift
# POSTGRES_USER=holly
# POSTGRES_PASSWORD=holly
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Leave empty to use in-process cache (no Redis) for development.
# REDIS_URL=redis://localhost:6379/0

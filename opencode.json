{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git checkout -b*": "allow",
      "ls*": "allow",
      "grep*": "allow",
      "make *": "allow",
      "pytest*": "allow",
      "ruff*": "allow",
      "docker compose*": "allow",
      "python manage.py*": "allow",
      "graphify*": "allow",
      "uv tool install graphifyy": "allow",
      "pip index versions*": "allow",
      "git push*": "ask",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "rm -rf*": "deny",
      "sudo *": "ask",
      "docker volume rm*": "deny",
      "docker system prune*": "deny"
    }
  }
}
